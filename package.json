{
  "name": "realtime-creator-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25",
    "bun": "1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "tsup>esbuild": "0.28.1",
    "brace-expansion@1.1.16": "1.1.18",
    "brace-expansion@5.0.8": "5.0.9",
    "fast-uri@3.1.4": "3.1.5",
    "fast-uri@4.1.1": "4.1.2",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  },
  "scripts": {
    "build:packages": "bun run --filter @studio/domain build && bun run --filter @studio/contracts build",
    "dev": "bun run build:packages && concurrently -k -n api,web -c blue,magenta \"bun run --filter @studio/api dev\" \"bun run --filter @studio/web dev\"",
    "build": "bun run build:packages && bun run --filter @studio/web build && bun run --filter @studio/api build",
    "start": "bun run --filter @studio/api start",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run packages apps/web/src",
    "test:integration": "vitest run apps/api/src apps/web/vite.config.test.ts scripts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "storybook:typecheck": "tsc --noEmit -p tsconfig.storybook.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:all": "bun run test && bun run build && bun run test:production && bun run test:e2e && bun run test:visual",
    "audit:all": "bun audit --ignore GHSA-67mh-4wv8-2f99",
    "audit:prod": "bun audit --audit-level high",
    "screenshots:prune": "node scripts/prune-visual-baselines.mjs",
    "check:dead-code": "knip --no-progress --reporter compact",
    "check:dead-code:production": "knip --production --no-progress --include files,dependencies,unlisted,unresolved --reporter compact",
    "check:modules": "node scripts/check-module-graph.mjs",
    "check:build-manifest": "node scripts/check-build-manifest.mjs",
    "check:script-references": "node scripts/check-script-references.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:retired-program": "node scripts/check-retired-program-references.mjs",
    "recording:memory:estimate": "node scripts/estimate-recording-memory.mjs",
    "auth:hash-password": "node scripts/hash-demo-password.mjs",
    "db:migrate": "bun run --filter @studio/api db:migrate",
    "screenshots:capture": "playwright test --config playwright.screenshots.config.ts",
    "quality": "bun run typecheck && bun run storybook:typecheck && bun run lint && bun run format:check && bun run check:dead-code && bun run check:modules && bun run check:script-references && bun run check:docs && bun run check:retired-program && bun run test && bun run build && bun run check:build-manifest && bun run storybook:build"
  },
  "devDependencies": {
    "@node-rs/argon2": "2.0.2",
    "@axe-core/playwright": "4.12.1",
    "@emnapi/runtime": "1.11.3",
    "@emotion/react": "11.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.4",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "knip": "6.29.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.5",
    "tsup": "8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
