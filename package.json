{
  "name": "realtime-creator-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=26 <27",
    "bun": "1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "esbuild": "0.28.1",
    "brace-expansion@1.1.16": "1.1.18",
    "brace-expansion@5.0.8": "5.0.9",
    "browserslist": "4.28.8",
    "update-browserslist-db": "1.3.2",
    "fast-uri@3.1.4": "3.1.5",
    "fast-uri@4.1.1": "4.1.2",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "@opentelemetry/sdk-node": "0.221.0"
  },
  "scripts": {
    "build:packages": "bun run --filter @studio/domain build && bun run --filter @studio/contracts build",
    "dev:ports": "node scripts/free-development-ports.mjs",
    "dev:servers": "bun run dev:ports && concurrently -k -n api,web -c blue,magenta \"bun run --filter @studio/api dev\" \"bun run --filter @studio/web dev\"",
    "dev": "bun run db:development:up && bun run db:migrate:development && bun run build:packages && LIGHTFRAME_ENV=development bun run dev:servers",
    "dev:ci": "bun run db:migrate:development && bun run build:packages && bun run dev:servers",
    "build": "bun run build:packages && bun run --filter @studio/web build && bun run --filter @studio/api build",
    "start": "bun run --filter @studio/api start",
    "start:production": "bun run --filter @studio/api start:production",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --max-warnings 0 --cache --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run packages apps/web/src",
    "test:integration": "vitest run apps/api/src apps/web/vite.config.test.ts scripts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "storybook:typecheck": "tsc --noEmit -p tsconfig.storybook.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots=all",
    "test:visual:linux": "node scripts/capture-linux-visual-baselines.mjs",
    "test:visual:linux:update": "node scripts/capture-linux-visual-baselines.mjs --update-snapshots=all",
    "test:all": "bun run test && bun run build && bun run test:production && bun run test:e2e && bun run test:visual",
    "audit:all": "bun audit --ignore GHSA-67mh-4wv8-2f99",
    "audit:prod": "bun audit --prod --audit-level high",
    "screenshots:prune": "node scripts/prune-visual-baselines.mjs",
    "check:dead-code": "knip --no-progress --reporter compact",
    "check:dead-code:production": "knip --production --no-progress --include files,dependencies,unlisted,unresolved --reporter compact",
    "check:modules": "node scripts/check-module-graph.mjs",
    "check:build-manifest": "node scripts/check-build-manifest.mjs",
    "check:script-references": "node scripts/check-script-references.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:retired-program": "node scripts/check-retired-program-references.mjs",
    "recording:memory:estimate": "node scripts/estimate-recording-memory.mjs",
    "auth:hash-password": "node scripts/hash-demo-password.mjs",
    "env:prepare": "bun run --filter @studio/api env:prepare",
    "db:development:up": "node scripts/development-compose.mjs up",
    "db:development:down": "node scripts/development-compose.mjs down",
    "db:development:logs": "node scripts/development-compose.mjs logs",
    "db:development:reset": "node scripts/development-compose.mjs reset",
    "db:migrate:development": "bun run --filter @studio/api db:migrate:development",
    "db:migrate:production": "bun run --filter @studio/api db:migrate:production",
    "db:smoke:development": "bun run --filter @studio/api db:smoke:development",
    "r2:cors:development:set": "bunx wrangler@4.121.0 r2 bucket cors set lightframe-studio-development --file apps/api/config/r2-cors.development.json",
    "r2:cors:development:check": "bunx wrangler@4.121.0 r2 bucket cors list lightframe-studio-development",
    "screenshots:capture": "playwright test --config playwright.screenshots.config.ts",
    "quality": "bun run typecheck && bun run storybook:typecheck && bun run lint && bun run format:check && bun run check:dead-code && bun run check:modules && bun run check:script-references && bun run check:docs && bun run check:retired-program && bun run test && bun run build && bun run check:build-manifest && bun run storybook:build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.1",
    "@emnapi/runtime": "1.11.3",
    "@emotion/react": "11.14.0",
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.4.1",
    "@node-rs/argon2": "2.1.0",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "storybook": "10.5.8",
    "tsup": "8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
