# Phase 1 loopback-only demo authentication. The Login form intentionally prefills these fake
# development credentials. Replace the JWT secret in every non-development environment. The
# Argon2id hash below must match DEMO_USER_PASSWORD when either value is changed.
DEMO_AUTH_ENABLED=true
DEMO_AUTH_PREFILL=true
DEMO_USER_ID=2d7914b2-f912-4b96-b17d-54100a2ffea3
DEMO_USER_LOGIN=demo@lightframe.local
DEMO_USER_DISPLAY_NAME=Demo Creator
DEMO_USER_PASSWORD=lightframe-demo
DEMO_USER_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$AQ6KYL1hKyx+ajWTKCCdCA$wrv4SBSsWdptAwMQE3QHId1riBhXxJ/10dvv0Kh/HK8
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_NAME=lightframe_session
# Local HTTP loopback requires false. Set true before any separately approved HTTPS deployment.
AUTH_COOKIE_SECURE=false

# Persistence cutover. local preserves the current file/in-memory runtime. shadow keeps file
# metadata authoritative while writing durable job traces to Neon; with R2 selected, new saved
# video bytes are also written to both R2 and the local rollback store. neon makes the Drizzle
# repositories authoritative. Run migrations and the local backfill before switching to neon.
DATABASE_MODE=local
DATABASE_URL=

# Private media bytes. R2 requires DATABASE_MODE=shadow or neon. Keep the bucket private. In
# authoritative neon/r2 mode, Saved Video writes use short-lived, exact-part presigned URLs and the
# bucket must allow PUT from only the exact app origins and expose ETag; see CLOUD_PERSISTENCE.md.
# Shadow mode keeps the server-mediated upload so it can retain its local rollback copy. After
# assets exist, changing the provider, account, bucket, or key prefix requires a reviewed migration.
ASSET_STORE_PROVIDER=local
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
S3_API_URL=
R2_BUCKET=
R2_KEY_PREFIX=media/v1

# Optional OTLP/HTTP protobuf tracing. Both the explicit flag and endpoint are required to register
# telemetry. The ratio is in [0,1]; prompts, credentials, URLs, paths, object keys, and media are
# excluded at the exporter boundary.
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1
VIDEO_JOB_MAX_ACTIVE=8
VIDEO_JOB_MAX_ACTIVE_PER_PROVIDER=4

# Server-only Decart credential used to mint short-lived browser tokens.
DECART_API_KEY=

# Existing-video Character Swap provider, selected only at server startup. Virtual Try-On and
# realtime Character/VTO remain on Decart. There is no browser selector and no fallback.
EXISTING_VIDEO_CHARACTER_SWAP_PROVIDER=decart

# Optional Pruna P-Video-Replace candidate for existing-video Character Swap only. All four
# values are required when PRUNA_VIDEO_REPLACE_ENABLED=true. The model literal is
# pinned and other values are rejected at startup.
PRUNA_VIDEO_REPLACE_ENABLED=false
PRUNA_API_KEY=
PRUNA_VIDEO_REPLACE_MODEL=p-video-replace

# Optional Saved Character Wardrobe Add Outfit provider. Disabled means the browsing and
# Change Features flows remain available; both values are required when enabled.
PRUNA_IMAGE_TRY_ON_ENABLED=false
PRUNA_IMAGE_TRY_ON_MODEL=p-image-try-on

# Optional server-only OpenAI prompt optimization. It also powers reference images when
# REFERENCE_IMAGE_PROVIDER=openai. The browser never receives this credential.
OPENAI_API_KEY=
OPENAI_PROMPT_OPTIMIZER_MODEL=gpt-5.6
OPENAI_PROMPT_OPTIMIZER_REASONING=medium
OPENAI_PROMPT_OPTIMIZER_VERSION=character-reference-v2
# Range: 10000-180000. Defaults to 120000 (2 minutes).
OPENAI_PROMPT_OPTIMIZER_TIMEOUT_MS=120000
OPENAI_REFERENCE_IMAGE_MODEL=gpt-image-2
OPENAI_REFERENCE_IMAGE_QUALITY=high

# Server-selected reference-image provider. There is no browser selector or fallback.
# REFERENCE_IMAGE_PROVIDER=bfl
# REFERENCE_IMAGE_PROVIDER=wiro

REFERENCE_IMAGE_PROVIDER=openai

# Optional Black Forest Labs FLUX.2 Pro reference-image provider.
BFL_API_KEY=
# Pinned production snapshot; other values are rejected at startup.
BFL_REFERENCE_IMAGE_MODEL=flux-2-pro
# Range: 0-5. Defaults to 2.
BFL_SAFETY_TOLERANCE=2
# Strict boolean. true sends disable_pup=true so the supplied prompt is used as-is.
BFL_DISABLE_PROMPT_UPSAMPLING=true
# Range: 10000-180000. One deadline covers submit, polling, and signed-result download.
BFL_REFERENCE_IMAGE_TIMEOUT_MS=150000

# Optional Wiro ByteDance Seedream v5 Lite reference-image provider. Both server-only
# credentials are required for signature authentication.
WIRO_API_KEY=
WIRO_API_SECRET=
# Pinned production model; other values are rejected at startup.
WIRO_REFERENCE_IMAGE_MODEL=seedream-v5-lite-uncensored
# Range: 10000-180000. One deadline covers submit, polling, download, and normalization.
WIRO_REFERENCE_IMAGE_TIMEOUT_MS=180000

# Durable uploaded and generated Character Builder reference storage.
# Relative paths resolve from the repository root; absolute paths remain absolute.
LIGHTFRAME_DATA_DIR=./.lightframe-data

# Optional ElevenLabs integration. Use a server-only restricted key with voice-read and
# speech-to-speech access. Studio lists only voices already saved in that account's library;
# library membership is managed in ElevenLabs. Local capture and local effects work without it.
ELEVENLABS_API_KEY=
ELEVENLABS_STS_MODEL_ID=eleven_multilingual_sts_v2
# Strict boolean forwarded to speech-to-speech conversion. false requests zero retention and may
# require an eligible ElevenLabs account; set true only after reviewing the provider's retention
# terms for this local environment.
ELEVENLABS_ENABLE_LOGGING=false

# Loopback Bun/Elysia API port and validated runtime mode. Bun automatic dotenv loading is disabled;
# API startup deliberately reads only the repository-root .env through the app configuration path.
PORT=4100
NODE_ENV=development
