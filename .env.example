# Server-only Decart credential used to mint short-lived browser tokens.
DECART_API_KEY=

# Existing-video Character Swap provider, selected only at server startup. Virtual Try-On and
# realtime Character/VTO remain on Decart. There is no browser selector and no fallback.
EXISTING_VIDEO_CHARACTER_SWAP_PROVIDER=decart

# Optional Pruna P-Video-Replace candidate for existing-video Character Swap only. All four
# values are required when EXISTING_VIDEO_CHARACTER_SWAP_PROVIDER=pruna. The model literal is
# pinned and other values are rejected at startup.
PRUNA_VIDEO_REPLACE_ENABLED=false
PRUNA_API_KEY=
PRUNA_VIDEO_REPLACE_MODEL=p-video-replace

# Optional server-only OpenAI prompt optimization. It also powers reference images when
# REFERENCE_IMAGE_PROVIDER=openai. The browser never receives this credential.
OPENAI_API_KEY=
OPENAI_PROMPT_OPTIMIZER_MODEL=gpt-5.6
OPENAI_PROMPT_OPTIMIZER_REASONING=medium
OPENAI_PROMPT_OPTIMIZER_VERSION=lucy-character-reference-v1
# Range: 10000-180000. Defaults to 120000 (2 minutes).
OPENAI_PROMPT_OPTIMIZER_TIMEOUT_MS=120000
OPENAI_REFERENCE_IMAGE_MODEL=gpt-image-2
OPENAI_REFERENCE_IMAGE_QUALITY=high

# Server-selected reference-image provider. There is no browser selector or fallback.
# REFERENCE_IMAGE_PROVIDER=bfl
# REFERENCE_IMAGE_PROVIDER=wiro

REFERENCE_IMAGE_PROVIDER=openai

# Optional Black Forest Labs FLUX.2 Pro reference-image provider.
BFL_API_KEY=
# Pinned production snapshot; other values are rejected at startup.
BFL_REFERENCE_IMAGE_MODEL=flux-2-pro
# Range: 0-5. Defaults to 2.
BFL_SAFETY_TOLERANCE=2
# Strict boolean. true sends disable_pup=true so the supplied prompt is used as-is.
BFL_DISABLE_PROMPT_UPSAMPLING=true
# Range: 10000-180000. One deadline covers submit, polling, and signed-result download.
BFL_REFERENCE_IMAGE_TIMEOUT_MS=150000

# Optional Wiro ByteDance Seedream v5 Lite reference-image provider. Both server-only
# credentials are required for signature authentication.
WIRO_API_KEY=
WIRO_API_SECRET=
# Pinned production model; other values are rejected at startup.
WIRO_REFERENCE_IMAGE_MODEL=seedream-v5-lite-uncensored
# Range: 10000-180000. One deadline covers submit, polling, download, and normalization.
WIRO_REFERENCE_IMAGE_TIMEOUT_MS=180000

# Durable uploaded and generated Character Builder reference storage.
# Relative paths resolve from the repository root; absolute paths remain absolute.
LIGHTFRAME_DATA_DIR=./.lightframe-data

# Optional ElevenLabs integration. Use a server-only restricted key with voice-read and
# speech-to-speech access. Studio lists only voices already saved in that account's library;
# library membership is managed in ElevenLabs. Local capture and local effects work without it.
ELEVENLABS_API_KEY=
ELEVENLABS_STS_MODEL_ID=eleven_multilingual_sts_v2
# Strict boolean forwarded to speech-to-speech conversion. false requests zero retention and may
# require an eligible ElevenLabs account; set true only after reviewing the provider's retention
# terms for this local environment.
ELEVENLABS_ENABLE_LOGGING=false

# Loopback API port and validated runtime mode.
PORT=4100
NODE_ENV=development
