{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "types": ["vite/client", "node"],
    "paths": {
      "@web/*": ["./apps/web/src/*"],
      "@studio/domain": ["./packages/domain/src/index.ts"],
      "@studio/contracts": ["./packages/contracts/src/index.ts"]
    }
  },
  "include": [".storybook/**/*.ts", ".storybook/**/*.tsx", "stories/**/*.ts", "stories/**/*.tsx"]
}
