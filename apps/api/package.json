{
  "name": "@studio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --platform node --clean --sourcemap",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/api/src",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:backfill-local": "tsx scripts/backfill-local-data.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/lib-storage": "3.1106.0",
    "@decartai/sdk": "0.1.17",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@node-rs/argon2": "2.0.2",
    "@neondatabase/serverless": "1.1.0",
    "@studio/contracts": "workspace:*",
    "@studio/domain": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.0",
    "jose": "6.2.8",
    "mediabunny": "1.52.0",
    "openai": "7.2.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
