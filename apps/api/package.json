{
  "name": "@studio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --no-env-file --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --format=esm --packages=external --sourcemap=external --outdir=dist",
    "start": "bun run --no-env-file dist/server.js",
    "start:production": "LIGHTFRAME_ENV=production bun run --no-env-file dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/api/src",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate:development": "LIGHTFRAME_ENV=development drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:production": "LIGHTFRAME_ENV=production drizzle-kit migrate --config drizzle.config.ts",
    "db:smoke:development": "LIGHTFRAME_ENV=development bun run --no-env-file scripts/database-smoke.ts",
    "db:backfill-local": "LIGHTFRAME_ENV=production bun run --no-env-file scripts/backfill-local-data.ts",
    "db:verify-sources": "LIGHTFRAME_ENV=development bun run --no-env-file scripts/verify-project-source-collection.ts",
    "env:prepare": "bun run --no-env-file scripts/prepare-environment-files.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/lib-storage": "3.1159.0",
    "@aws-sdk/s3-request-presigner": "3.1159.0",
    "@decartai/sdk": "0.2.14",
    "@elysia/opentelemetry": "1.4.12",
    "@elysiajs/static": "1.4.10",
    "@fastify/busboy": "3.2.4",
    "@node-rs/argon2": "2.2.2",
    "@neondatabase/serverless": "1.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@studio/contracts": "workspace:*",
    "@studio/domain": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "jose": "6.2.14",
    "mediabunny": "1.63.0",
    "openai": "7.45.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
