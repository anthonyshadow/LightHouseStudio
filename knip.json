{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "paths": {
        "@web/*": ["apps/web/src/*"],
        "@studio/domain": ["packages/domain/src/index.ts"],
        "@studio/contracts": ["packages/contracts/src/index.ts"]
      },
      "entry": [
        "stories/**/*.stories.{ts,tsx}",
        "stories/**/*.mdx",
        "e2e/**/*.{spec,screenshots}.ts",
        "scripts/**/*.mjs"
      ],
      "project": [
        ".storybook/**/*.{ts,tsx}",
        "stories/**/*.{ts,tsx,mdx}",
        "*.{ts,mjs}",
        "e2e/**/*.ts",
        "scripts/**/*.mjs"
      ],
      "ignoreDependencies": ["@emnapi/runtime"],
      "ignoreBinaries": ["colima", "docker", "docker-compose"],
      "ignoreExportsUsedInFile": true
    },
    "apps/api": {
      "entry": ["src/server.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!", "!src/test/**!"],
      "ignoreExportsUsedInFile": true
    },
    "apps/web": {
      "entry": ["src/main.tsx!", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}!", "!src/test/**!", "vite.config{,.test}.ts"],
      "ignoreExportsUsedInFile": true
    },
    "packages/contracts": {
      "entry": ["src/index.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"],
      "ignoreIssues": {
        "src/reference-images.ts": ["duplicates"]
      }
    },
    "packages/domain": {
      "entry": ["src/index.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"]
    }
  }
}
