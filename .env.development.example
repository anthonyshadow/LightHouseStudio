# Copy to .env.development. This file is loopback development only.
LIGHTFRAME_ENV=development
NODE_ENV=development
PORT=4100

DEMO_AUTH_ENABLED=true
DEMO_AUTH_PREFILL=true
DEMO_USER_ID=2d7914b2-f912-4b96-b17d-54100a2ffea3
DEMO_USER_LOGIN=demo@lightframe.local
DEMO_USER_DISPLAY_NAME=Demo Creator
DEMO_USER_PASSWORD=lightframe-demo
DEMO_USER_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$AQ6KYL1hKyx+ajWTKCCdCA$wrv4SBSsWdptAwMQE3QHId1riBhXxJ/10dvv0Kh/HK8
AUTH_JWT_SECRET=replace-with-a-development-secret-at-least-32-characters
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_NAME=lightframe_session_development
AUTH_COOKIE_SECURE=false

DATABASE_MODE=postgres
DATABASE_URL=postgresql://lightframe:lightframe-local-development@127.0.0.1:5433/lightframe_development

ASSET_STORE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lightframe-studio-development
R2_KEY_PREFIX=media/v1
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1
VIDEO_JOB_MAX_ACTIVE=8
VIDEO_JOB_MAX_ACTIVE_PER_PROVIDER=4

# Paid provider credentials are intentionally disabled until separate restricted development keys exist.
DECART_API_KEY=
EXISTING_VIDEO_CHARACTER_SWAP_PROVIDER=decart
PRUNA_VIDEO_REPLACE_ENABLED=false
PRUNA_API_KEY=
PRUNA_VIDEO_REPLACE_MODEL=p-video-replace
PRUNA_IMAGE_TRY_ON_ENABLED=false
PRUNA_IMAGE_TRY_ON_MODEL=p-image-try-on
OPENAI_API_KEY=
OPENAI_PROMPT_OPTIMIZER_MODEL=gpt-5.6
OPENAI_PROMPT_OPTIMIZER_REASONING=medium
OPENAI_PROMPT_OPTIMIZER_VERSION=character-reference-v2
OPENAI_PROMPT_OPTIMIZER_TIMEOUT_MS=120000
OPENAI_REFERENCE_IMAGE_MODEL=gpt-image-2
OPENAI_REFERENCE_IMAGE_QUALITY=high
REFERENCE_IMAGE_PROVIDER=openai
BFL_API_KEY=
BFL_REFERENCE_IMAGE_MODEL=flux-2-pro
BFL_SAFETY_TOLERANCE=2
BFL_DISABLE_PROMPT_UPSAMPLING=true
BFL_REFERENCE_IMAGE_TIMEOUT_MS=150000
WIRO_API_KEY=
WIRO_API_SECRET=
WIRO_REFERENCE_IMAGE_MODEL=seedream-v5-lite-uncensored
WIRO_REFERENCE_IMAGE_TIMEOUT_MS=180000
ELEVENLABS_API_KEY=
ELEVENLABS_STS_MODEL_ID=eleven_multilingual_sts_v2
ELEVENLABS_ENABLE_LOGGING=false
LIGHTFRAME_DATA_DIR=./.lightframe-data/development
